<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);MAC</DefineConstants>
    <AssemblyName>Luxis</AssemblyName>
    <RootNamespace>Luxis</RootNamespace>
    <ApplicationIcon>../app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="MacBridge.cs" />
    <Compile Include="BridgeServer.cs" />
    <Compile Include="JSBridge.cs" />
    <Compile Include="Platform.cs" />
    <Compile Include="../src/AuthService.cs" Link="Services/AuthService.cs" />
    <Compile Include="../src/BundledLuxisMod.cs" Link="Services/BundledLuxisMod.cs" />
    <Compile Include="../src/JavaInstaller.cs" Link="Services/JavaInstaller.cs" />
    <Compile Include="../src/MinecraftService.cs" Link="Services/MinecraftService.cs" />
    <Compile Include="../src/ModrinthService.cs" Link="Services/ModrinthService.cs" />
    <Compile Include="../src/MrpackService.cs" Link="Services/MrpackService.cs" />
    <Compile Include="../src/Textures.cs" Link="Services/Textures.cs" />
    <Compile Include="../src/UpdateService.cs" Link="Services/UpdateService.cs" />
    <Compile Include="../src/Util.cs" Link="Services/Util.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../index.html" LogicalName="Luxis.index.html" />
    <EmbeddedResource Include="../version.txt" LogicalName="Luxis.version.txt" />
    <EmbeddedResource Include="../textures/*.png" LogicalName="tex_%(Filename)%(Extension)" />
    <EmbeddedResource Include="../LuxisClientMod.jar" LogicalName="Luxis.LuxisClientMod.jar" />
    <EmbeddedResource Include="../LuxisClientMod-1.21x.jar" LogicalName="Luxis.LuxisClientMod-1.21x.jar" />
  </ItemGroup>
</Project>
